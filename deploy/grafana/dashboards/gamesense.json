        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(audit_detection_recall)"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Simulated time",
      "description": "",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(sim_time_seconds) * 1000"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Concurrent players by region (the daily wave)",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (region) (sim_players)",
          "legendFormat": "{{region}}"
        },
        {
          "refId": "B",
          "expr": "sum(sim_players)",
          "legendFormat": "total"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Throughput: generated vs ingested vs processed",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(sim_events_generated_total[1m]))",
          "legendFormat": "generated"
        },
        {
          "refId": "B",
          "expr": "sum(rate(ingest_events_total{result=\"accepted\"}[1m]))",
          "legendFormat": "ingested"
        },
        {
          "refId": "C",
          "expr": "sum(rate(worker_events_processed_total[1m]))",
          "legendFormat": "processed"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Ingest latency",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(ingest_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(ingest_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p99"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(ingest_produce_duration_seconds_bucket[1m])))",
          "legendFormat": "p99 broker ack"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "End-to-end latency (event generated -> worker)",
